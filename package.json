{
  "name": "mudre-misli",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run build:quotes",
    "dev": "npm run dev:watch",
    "dev:watch": "npm-run-all --parallel dev:next dev:quotes",
    "dev:next": "next dev",
    "dev:quotes": "chokidar \"data/quotes/**/*.json\" -c \"npm run build:quotes\"",
    "prebuild": "npm run build:quotes",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "build:quotes": "node tools/build-quotes.mjs",
    "build:sources": "node tools/build-source-map.mjs"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@types/node": "20.16.1",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "chokidar-cli": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "5.6.3"
  }
}
