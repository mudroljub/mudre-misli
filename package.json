{
  "name": "mudre-misli",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:watch",
    "dev:watch": "npm-run-all --parallel dev:next dev:quotes",
    "dev:next": "next dev",
    "dev:quotes": "chokidar \"data/quotes/**/*.json\" -c \"npm run build:quotes\"",
    "prebuild": "npm run build:data",
    "build": "next build",
    "build:static": "node tools/build-static.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "assign:ids": "node tools/assign-entry-ids.mjs",
    "build:quotes": "node tools/build-quotes.mjs",
    "build:works": "node tools/build-works.mjs",
    "build:work-originals": "node tools/build-work-originals.mjs",
    "audit:work-drafts": "node tools/build-work-originals.mjs --drafts",
    "build:work-data": "npm-run-all --serial build:works build:work-originals",
    "build:data": "npm-run-all --parallel build:quotes build:work-data",
    "build:sources": "node tools/build-source-map.mjs",
    "build:source:burley": "node tools/build-walter-burley-source.mjs",
    "build:source:suda": "node tools/build-suda-index.mjs",
    "build:catalog:philosophers": "node tools/build-philosopher-catalog.mjs",
    "audit:duplicates": "node tools/audit-duplicates.mjs",
    "audit:work-anchors": "node tools/audit-work-anchors.mjs",
    "align:work-anchors": "node tools/apply-work-anchor-map.mjs",
    "prepare:planned-works": "node tools/prepare-planned-works.mjs"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sass": "^1.102.0"
  },
  "devDependencies": {
    "@types/node": "20.16.1",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "chokidar-cli": "^3.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "5.6.3"
  }
}
