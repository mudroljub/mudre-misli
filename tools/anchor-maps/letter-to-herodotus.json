{
  "work": "epicurus/letter-to-herodotus",
  "anchors": {
    "35": { "sr": { "before": "Epikur Herodotu, pozdrav." }, "stsl": { "before": "Епикѹръ Херодотѹ радовати сѧ ·" } },
    "36": { "sr": { "before": "Treba, dakle, neprestano pristupati pojedinostima" }, "stsl": { "before": "Подобаєть ѹбо непрѣстаньно и къ частемъ ходити" } },
    "37": { "sr": { "before": "Pošto je takav put koristan" }, "stsl": { "before": "Понеже таковъ пѫть" } },
    "38": { "sr": { "before": "Jer prvobitni" }, "stsl": { "before": "Пръвоє бо поѩтиє" } },
    "39": { "sr": { "before": "Kada\nbi ono što nestaje" }, "stsl": { "before": "Аште же исчезаѭштеє" } },
    "40": { "sr": { "before": "Kada ne bi bilo" }, "stsl": { "before": "Аште не\nбы бѣло" } },
    "41": { "sr": { "before": "To su\nnedeljive i nepromenljive" }, "stsl": { "before": "Си же сѫть недѣлима" } },
    "42": { "sr": { "before": "Kada bi praznina\nbila beskrajna" }, "stsl": { "before": "Аште бо\nпраздьнота бескраина" } },
    "43": { "sr": { "before": "razlika oblika nije naprosto" }, "stsl": { "before": "разликъ же образъ не просто" } },
    "44": { "sr": { "before": "Priroda praznine koja svaku razdvaja" }, "stsl": { "before": "Естество праздьноты" } },
    "45": { "sr": { "before": "Ovaj kratki iskaz" }, "stsl": { "before": "Кратъкъ сеи гласъ" } },
    "46": { "sr": { "before": "Postoje i obrisi" }, "stsl": { "before": "Сѫть же и образы" } },
    "47": { "sr": { "before": "Telo koje se kreće" }, "stsl": { "before": "Движѫштеє сѧ тѣло" } },
    "48": { "sr": { "before": "Nastanak likova" }, "stsl": { "before": "Рождениє видѣнии" } },
    "49": { "sr": { "before": "Treba smatrati da oblike" }, "stsl": { "before": "Подобаєть мьнѣти ꙗко образъ" } },
    "50": { "sr": { "before": "zato daju predstavu" }, "stsl": { "before": "Сего ради єдинаго" } },
    "51": { "sr": { "before": "Sličnost predstava" }, "stsl": { "before": "Подобиє бо предъставъ" } },
    "52": { "sr": { "before": "Ovo mnjenje treba čvrsto držati" }, "stsl": { "before": "Се мьнѣниє крѣпъко" } },
    "53": { "sr": { "before": "Bez\nveze koja se odande" }, "stsl": { "before": "Безъ отънѫдѹ\nприносимаго" } },
    "54": { "sr": { "before": "Nedeljive čestice nemaju" }, "stsl": { "before": "Недѣлима ниєдино качество" } },
    "55": { "sr": { "before": "I kod stvari oko nas" }, "stsl": { "before": "И въ ѹ насъ" } },
    "56": { "sr": { "before": "Postojanje svih veličina" }, "stsl": { "before": "Вьсѣкои\nже величинѣ" } },
    "57": { "sr": { "before": "Kada neko jednom kaže" }, "stsl": { "before": "Єгда кто єдиноѭ" } },
    "58": { "sr": { "before": "Najmanje što se opaža" }, "stsl": { "before": "Наимьншєє чѹвьствомъ" } },
    "59": { "sr": { "before": "Po istoj srazmeri" }, "stsl": { "before": "По томѹже съразмѣрию" } },
    "60": { "sr": { "before": "O beskraju ne treba" }, "stsl": { "before": "О бескраинѣмь" } },
    "61": { "sr": { "before": "Nedeljive čestice nužno" }, "stsl": { "before": "Недѣлима нѫжьно равноѥ" } },
    "62": { "sr": { "before": "Kod sklopova će se" }, "stsl": { "before": "Въ сложениихъ же" } },
    "63": { "sr": { "before": "Zatim treba, svodeći" }, "stsl": { "before": "По сихъ подобаєть" } },
    "64": { "sr": { "before": "Ne bi ga imala kada je" }, "stsl": { "before": "Не бы же\nсего приѧла" } },
    "65": { "sr": { "before": "Zato duša, dok prebiva" }, "stsl": { "before": "Тѣмь дѹша" } },
    "66": { "sr": { "before": "Nije moguće zamisliti da ona opaža" }, "stsl": { "before": "Нѣсть бо помыслити ѭ" } },
    "67": { "sr": { "before": "Treba dodatno razumeti" }, "stsl": { "before": "Подобаєть и се приразѹмѣти" } },
    "68": { "sr": { "before": "Ko sva ova razmišljanja" }, "stsl": { "before": "Вьсѧ ѹбо си размышлєниꙗ" } },
    "69": { "sr": { "before": "niti smatrati da uopšte ne" }, "stsl": { "before": "ни ꙗко\nвьсѣма не сѫть" } },
    "70": { "sr": { "before": "Telima često pripada" }, "stsl": { "before": "Тѣлесемъ чѧсто" } },
    "71": { "sr": { "before": "Tu očiglednost ne treba" }, "stsl": { "before": "Ꙗвьности сеѩ" } },
    "72": { "sr": { "before": "Treba naročito razumeti" }, "stsl": { "before": "И се силно приразѹмѣти" } },
    "73": { "sr": { "before": "Tome nije potreban dokaz" }, "stsl": { "before": "Семѹ бо не доказаниꙗ" } },
    "74": { "sr": { "before": "Ne treba smatrati da svi svetovi" }, "stsl": { "before": "Не подобаєть мьнѣти вьсѧ міры" } },
    "75": { "sr": { "before": "Treba pretpostaviti i da je priroda" }, "stsl": { "before": "Мьнѣти же подобаєть и ꙗко естество" } },
    "76": { "sr": { "before": "Potom su u svakom narodu" }, "stsl": { "before": "Потомь же въ коемьждо народѣ" } },
    "77": { "sr": { "before": "Poslovi, brige, gnev i naklonost" }, "stsl": { "before": "Дѣла бо ·\nпопечениꙗ" } },
    "78": { "sr": { "before": "Treba smatrati da je posao" }, "stsl": { "before": "Дѣло єстествоиспытаниꙗ" } },
    "79": { "sr": { "before": "Puko poznavanje" }, "stsl": { "before": "Тъкъмо знаниє" } },
    "80": { "sr": { "before": "ne treba misliti da naše istraživanje" }, "stsl": { "before": "не подобаєть\nмьнѣти испытаниє" } },
    "81": { "sr": { "before": "U svemu tome treba" }, "stsl": { "before": "Въ вьсѣхъ сихъ" } },
    "82": { "sr": { "before": "Neuznemirenost je oslobođenje" }, "stsl": { "before": "Немѧтежьность же єсть" } },
    "83": { "sr": { "before": "Ako se ovaj prikaz tačno" }, "stsl": { "before": "Аште сказаниє се" } }
  }
}
